{
  "general": {
    "name": { "en": "cbsb0stats" },
    "version": "1.2.0",
    "vendor": "MPGCBS",
    "information": { "en": "Creates a b0-map image and calculates is mean and std from a gre field map (2 mag images, 1 phase diff image). NOTE: This recipe assumes the first scan is the gre field map, as such it will collect and copy the first 3 images, leaving all other images unaltered." },
    "id": "cbsb0stats",
  },
  "reconstruction": {
    "transfer_protocol": {
      "protocol": "ISMRMRD",
      "version": "1.4.1"
    },
    "port": 9002,
    "emitter": "image",
    "injector": "image",
    "can_process_adjustment_data": false,
    "can_use_gpu": false,
    "min_count_required_gpus": 0,
    "min_required_gpu_memory": 2048,
    "min_required_memory": 4096,
    "min_count_required_cpu_cores": 1,
    "content_qualification_type": "RESEARCH"
  },
  "parameters": [
    {
      "id": "config",
      "type": "choice",
      "label": { "en": "config" },
      "values": [
        {
          "id": "cbsb0stats",
          "name": { "en": "cbsb0stats" }
        }
      ],
      "default": "cbsb0stats",
      "information": { "en": "Define the config to be executed by MRD server" }
    },
    {
      "id": "NumDil",
      "label": {"en": "Number of Dilations"},
      "type": "int",
      "information": { "en": "Number of Dilations for the Brain Mask, NOTE: Dilations happen before Erosions" },
      "minimum": 0,
      "maximum": 100,
      "default": 2
    },
    {
      "id": "NumEro",
      "label": {"en": "Number of Erosions"},
      "type": "int",
      "information": { "en": "Number of Erosions for the Brain Mask, NOTE: Dilations happen before Erosions" },
      "minimum": 0,
      "maximum": 100,
      "default": 3
    },
    {
      "id": "FracIntens",
      "label": { "en": "Fractional Intenstiy" },
      "type": "double",
      "information": { "en": "bet2 -f argument; fractional intensity threshold (0->1); default=0.4; smaller values give larger brain outline estimates" },
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.4
    },    
    {
      "id": "SendOriginals",
      "label": { "en": "Send Original Images" },
      "type": "boolean",
      "information": { "en": "Send Original Magnitude 1, 2 and Phase images back along with B0map" },
      "default": true
    },  
    {
      "id": "gaussianSmoothing",
      "label": { "en": "gaussian smoothing" },
      "type": "boolean",
      "information": { "en": "Apply 2D slice-by-slice gaussian smoothing to the B0map image" },
      "default": false
    },    
    {
      "id": "TE1",
      "label": { "en": "Echo Time 1" },
      "type": "string",
      "information": { "en": "Manually define TE1 in case it cannot be found during scan. UNITS: milliseconds" },
      "default": "3.06"
    },
    {
      "id": "TE2",
      "label": { "en": "Echo Time 2" },
      "type": "string",
      "information": { "en": "Manually define TE2 in case it cannot be found during scan. UNITS: milliseconds" },
      "default": "4.08"
    },
    {
      "id": "VerboseLogging",
      "label": { "en": "Verbose Logging" },
      "type": "boolean",
      "information": { "en": "Enable Verbose Logging" },
      "default": false
    }
  ]
}
